DB_NAME=mauricette
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=

# --- Stockage documents ---
# STORAGE_PROVIDER=local -> stocke sur disque, dans STOCKAGE_LOCAL_DOSSIER
# STORAGE_PROVIDER=s3    -> stocke via l'API S3 (MinIO en local, ou Cloudflare R2 / AWS S3)
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=mauricette-documents
S3_REGION=us-east-1
S3_USE_SSL=false

# --- RAG (extraction, embeddings) ---
# Clé créée sur console.mistral.ai
MISTRAL_API_KEY=
